type User {
  id: ID!
  name: String!
  email: String!
  avatar: String!
  posts: [Post!]!
}

type Post {
  id: ID!
  title: String!
  content: String!
  createdAt: String!
  user: User!
  comments: [Comment!]!
}

type Comment {
  id: ID!
  text: String!
  createdAt: String!
  post: Post!
  author: User!
}

type Query {
  user(id: ID!): User
  users(ids: [ID!]!): [User!]!
  post(id: ID!): Post
  posts(userId: ID!): [Post!]!
  comment(id: ID!): Comment
  comments(postId: ID!): [Comment!]!
}
